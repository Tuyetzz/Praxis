# =============================================================================
# Production environment for the Raspberry Pi deployment.
#
#   cp .env.prod.example .env.prod
#   # fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod is gitignored - never commit it. This example file IS committed, so
# it must only ever contain placeholders.
#
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=examdb
MYSQL_PASSWORD=change-me-app

# --- JWT (backend signs access + refresh tokens with these) ---
JWT_ACCESS_SECRET=change-me-32-byte-random-hex
JWT_REFRESH_SECRET=change-me-different-32-byte-hex
ACCESS_TOKEN_EXPIRES=12h
REFRESH_TOKEN_EXPIRES=7d

# --- Seeded admin account (created on first boot) ---
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-strong-password

# --- AI quiz generation ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
# Prefer a NON-reasoning model: reasoning models spend their token budget
# thinking and can return empty content (finish_reason: "length").
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Runtime ---
# Port nginx listens on. Change to 8080 if something else owns port 80 on the Pi.
HTTP_PORT=80
# Cron job that auto-submits expired quiz attempts.
AUTO_SUBMIT_ENABLED=true

# --- Optional: only if the frontend is served from a different origin ---
# Comma-separated. Leave unset when nginx serves both the SPA and the API,
# because then every request is same-origin and CORS does not apply.
# CORS_ORIGINS=http://pi.local,http://192.168.1.50
